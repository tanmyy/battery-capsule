<Window x:Class="BatteryCapsule.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Battery Capsule Settings"
        Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FF202020">
    <StackPanel Margin="20">
        <TextBlock Text="Battery Capsule Settings" Foreground="White" FontSize="16" FontFamily="Segoe UI Semibold" Margin="0,0,0,14"/>

        <CheckBox x:Name="StartWithWindowsBox" Content="Start with Windows" Foreground="White" Margin="0,0,0,8"/>
        <CheckBox x:Name="AlwaysOnTopBox" Content="Always on top" Foreground="White" Margin="0,0,0,8"/>
        <CheckBox x:Name="ShowEstimatedBox" Content="Show estimated % on capsule (unchecked = Windows %)" Foreground="White" Margin="0,0,0,8"/>
        <CheckBox x:Name="ShowTimeBox" Content="Show time remaining on capsule" Foreground="White" Margin="0,0,0,14"/>

        <TextBlock Text="Transparency" Foreground="#CCFFFFFF" FontSize="11" Margin="0,0,0,2"/>
        <Slider x:Name="TransparencySlider" Minimum="0.5" Maximum="1.0" Margin="0,0,0,12"/>

        <TextBlock Text="Capsule size" Foreground="#CCFFFFFF" FontSize="11" Margin="0,0,0,2"/>
        <Slider x:Name="ScaleSlider" Minimum="0.8" Maximum="1.4" Margin="0,0,0,12"/>

        <TextBlock Text="Update frequency (seconds)" Foreground="#CCFFFFFF" FontSize="11" Margin="0,0,0,2"/>
        <Slider x:Name="FrequencySlider" Minimum="5" Maximum="60" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,0,0,14"/>

        <Separator Opacity="0.15" Margin="0,0,0,12"/>

        <TextBlock Text="Notifications (off by default)" Foreground="White" FontSize="13" FontFamily="Segoe UI Semibold" Margin="0,0,0,8"/>
        <CheckBox x:Name="NotificationsEnabledBox" Content="Enable notifications" Foreground="White" Margin="0,0,0,8"/>
        <CheckBox x:Name="Notify20Box" Content="Battery reaches 20%" Foreground="White" Margin="16,0,0,6"/>
        <CheckBox x:Name="Notify10Box" Content="Battery reaches 10%" Foreground="White" Margin="16,0,0,6"/>
        <CheckBox x:Name="NotifyLowTimeBox" Content="Estimated time remaining is very low" Foreground="White" Margin="16,0,0,6"/>
        <CheckBox x:Name="NotifyMismatchBox" Content="Windows % differs significantly from estimate" Foreground="White" Margin="16,0,0,6"/>
        <CheckBox x:Name="NotifyLowHealthBox" Content="Battery health is very low" Foreground="White" Margin="16,0,0,14"/>

        <Button x:Name="ResetLearningButton" Content="Reset battery learning / calibration data" Margin="0,0,0,14" Click="ResetLearning_Click"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Save" Width="80" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
