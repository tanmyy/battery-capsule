<Window x:Class="BatteryCapsule.Views.CapsuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Battery Capsule"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        Left="100" Top="100">
    <Border x:Name="PillBorder"
            CornerRadius="16"
            Background="#E6202020"
            Padding="12,6"
            MouseLeftButtonDown="Pill_MouseLeftButtonDown"
            MouseLeftButtonUp="Pill_MouseLeftButtonUp"
            MouseMove="Pill_MouseMove">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35" Color="Black"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="IconText" Text="🔋" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock x:Name="MainText" Text="--% · --" FontSize="13" FontFamily="Segoe UI Semibold"
                       Foreground="#FFF2F2F2" VerticalAlignment="Center"/>
            <Button x:Name="CloseButton" Content="✕" Click="CloseButton_Click"
                    Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                    Foreground="#99FFFFFF" FontSize="10" Padding="2,0,0,0" Margin="8,0,0,0"
                    Cursor="Hand" VerticalAlignment="Center" Focusable="False"
                    ToolTip="Close Battery Capsule"/>
        </StackPanel>
    </Border>
</Window>
