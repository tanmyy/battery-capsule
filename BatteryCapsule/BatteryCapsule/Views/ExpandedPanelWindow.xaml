<Window x:Class="BatteryCapsule.Views.ExpandedPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Battery"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        Deactivated="Window_Deactivated">
    <Border CornerRadius="14" Background="#F2202020" Padding="16" Width="270">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.4" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="Battery" FontSize="15" FontFamily="Segoe UI Semibold" Foreground="White" Margin="0,0,0,10"/>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Estimated battery" Foreground="#CCFFFFFF" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock x:Name="EstPercentText" Grid.Column="1" Text="--%" Foreground="White" FontSize="18" FontFamily="Segoe UI Semibold"/>
            </Grid>

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Windows reported" Foreground="#CCFFFFFF" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock x:Name="WinPercentText" Grid.Column="1" Text="--%" Foreground="#E0FFFFFF" FontSize="13" VerticalAlignment="Center"/>
            </Grid>

            <Border x:Name="ConsistencyBanner" CornerRadius="8" Background="#332E7D32" Padding="8,6" Margin="0,6,0,10">
                <TextBlock x:Name="ConsistencyText" Text="✓ Battery reading appears normal"
                           Foreground="#FFB9F6CA" FontSize="11" TextWrapping="Wrap"/>
            </Border>

            <Separator Margin="0,2,0,10" Opacity="0.15"/>

            <StackPanel x:Name="MetricsPanel"/>

            <TextBlock Text="Battery % over time" Foreground="#99FFFFFF" FontSize="10" Margin="0,12,0,2"/>
            <Border Background="#1AFFFFFF" CornerRadius="6" Height="46">
                <Canvas x:Name="GraphCanvas" ClipToBounds="True"/>
            </Border>

            <TextBlock Text="Click outside to close" Foreground="#66FFFFFF" FontSize="9" Margin="0,10,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
