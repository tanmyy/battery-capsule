<Application x:Class="BatteryCapsule.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>

        <SolidColorBrush x:Key="CapsuleBackgroundDark" Color="#E6202020"/>
        <SolidColorBrush x:Key="CapsuleBackgroundLight" Color="#E6FFFFFF"/>
        <SolidColorBrush x:Key="CapsuleTextDark" Color="#FFF2F2F2"/>
        <SolidColorBrush x:Key="CapsuleTextLight" Color="#FF1A1A1A"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#FF34C759"/>
        <SolidColorBrush x:Key="AccentYellow" Color="#FFF5A623"/>
        <SolidColorBrush x:Key="AccentRed" Color="#FFFF3B30"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#FF0A84FF"/>

    </Application.Resources>
</Application>
